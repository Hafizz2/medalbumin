# MedAlbumin — production environment for medalbumin.com
# Copy this file to .env ON THE SERVER, fill in every <...>, then run:
#   php artisan key:generate && php artisan migrate --force && php artisan config:cache
# Never commit the filled-in file.

APP_NAME=MedAlbumin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://medalbumin.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# cPanel databases are usually named <account>_medalbumin with a user <account>_medalbumin.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<cpanel_account>_medalbumin
DB_USERNAME=<cpanel_account>_medalbumin
DB_PASSWORD=<database password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.medalbumin.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting has no long-running worker by default; sync runs jobs inline.
# If you set this to "database", add a cron entry: php artisan queue:work --stop-when-empty
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Send real email through the hosting account (create noreply@medalbumin.com in cPanel → Email Accounts).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.medalbumin.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=noreply@medalbumin.com
MAIL_PASSWORD=<email password>
MAIL_FROM_ADDRESS="noreply@medalbumin.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- MedAlbumin ---
SUPPORT_EMAIL=support@medalbumin.com
CHAPA_SECRET_KEY=<from Chapa dashboard>
CHAPA_WEBHOOK_SECRET=<from Chapa dashboard>
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
EXPO_ACCESS_TOKEN=
TELEGRAM_SUPPORT_URL=https://t.me/mednexus_support
# Login codes via Telegram Gateway (OTP_DRIVER=telegram) once you have the token.
OTP_DRIVER=log
OTP_REVIEW_PHONE=
OTP_REVIEW_EMAIL=
OTP_REVIEW_CODE=
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_SENDER=
# Log In With Telegram (@BotFather → bot → Login Widget → domain medalbumin.com)
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_APP_RETURN=medalbumin://auth/telegram
REQUIRE_ADMIN_2FA=false

# Store links shown on the site once the apps are published.
PLAY_STORE_URL=
APP_STORE_URL=
ADMIN_EMAIL=admin@medalbumin.com
